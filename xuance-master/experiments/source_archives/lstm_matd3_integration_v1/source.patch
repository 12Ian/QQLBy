+"""Compare the optional JIT predictor to NumPy on the current machine."""
+from argparse import Namespace
+from importlib import import_module
+from pathlib import Path
+from statistics import median
+from time import perf_counter
+import sys
+
+import numpy as np
+
+
+SOURCE = Path(__file__).resolve().parents[1] / 'xuance/environment/multi_agent_env/uav_predictive_safety_3d.py'
+sys.path.insert(0, str(SOURCE.parent))
+safety = import_module('uav_predictive_safety_3d')
+
+
+def main():
+    env = Namespace(num_agents=4, decision_dt=.5, physics_dt=.1, acceleration_lag=.5,
+                    max_accel=3., uav_jerk_max=6., uav_max_speed=11.)
+    numpy_filter = safety.PredictiveSafetyFilter3D(
+        env, Namespace(safety_margin=2., safety_horizon_seconds=8.))
+    jit_filter = safety.PredictiveSafetyFilter3D(
+        env, Namespace(safety_margin=2., safety_horizon_seconds=8., safety_rollout_backend='numba'))
+    rng = np.random.default_rng(1)
+    for count in (1, 2, 8, 10):
+        matches = 0
+        first_mismatch = None
+        numpy_times, jit_times = [], []
+        for trial in range(1000):
+            env.uav_positions = rng.uniform(30, 970, (4, 3)).astype(np.float32)
+            env.uav_velocities = rng.uniform(-11, 11, (4, 3)).astype(np.float32)
+            env.uav_accelerations = rng.uniform(-3, 3, (4, 3)).astype(np.float32)
+            if trial % 4 == 0:
+                env.uav_velocities[0] = [11., 0., 0.]
+                env.uav_accelerations[1] = [3., 0., 0.]
+            commands = rng.uniform(-3, 3, (4, count, 3))
+            started = perf_counter()
+            expected_path, expected_radius = numpy_filter._rollout(commands)
+            numpy_times.append(perf_counter() - started)
+            started = perf_counter()
+            actual_path, actual_radius = jit_filter._rollout(commands)
+            jit_times.append(perf_counter() - started)
+            if (np.array_equal(actual_path, expected_path) and
+                    np.array_equal(actual_radius, expected_radius)):
+                matches += 1
+            elif first_mismatch is None:
+                first_mismatch = trial
+        print(dict(count=count, bitwise_matches=matches, first_mismatch=first_mismatch,
+                   numpy_ms=round(median(numpy_times) * 1000, 3),
+                   jit_ms=round(median(jit_times[1:]) * 1000, 3),
+                   jit_first_call_s=round(jit_times[0], 3) if count == 1 else None))
+    env.uav_radius = 2.
+    env.uav_collision_distance = 4.
+    env.map_size = 1000.
+    env.z_min, env.z_max = 50., 350.
+    env.buildings = np.array([[430., 560., 410., 550., 240.]], np.float32)
+    filter_matches = 0
+    numpy_filter_times, jit_filter_times = [], []
+    for trial in range(200):
+        env.uav_positions = rng.uniform([20., 20., 60.], [980., 980., 340.], (4, 3)).astype(np.float32)
+        env.uav_velocities = rng.uniform(-11, 11, (4, 3)).astype(np.float32)
+        env.uav_accelerations = rng.uniform(-3, 3, (4, 3)).astype(np.float32)
+        if trial % 4 == 0:
+            env.uav_positions[:, :2] = [[420., 450.], [570., 450.], [500., 400.], [500., 560.]]
+        elif trial % 4 == 1:
+            env.uav_positions[:, 0] = [6., 994., 7., 993.]
+        elif trial % 4 == 2:
+            env.uav_positions[:, :2] = [[450., 450.], [455., 450.], [500., 500.], [505., 500.]]
+        proposal = rng.uniform(-3., 3., (4, 3))
+        started = perf_counter()
+        expected = numpy_filter.filter(proposal)
+        numpy_filter_times.append(perf_counter() - started)
+        started = perf_counter()
+        actual = jit_filter.filter(proposal)
+        jit_filter_times.append(perf_counter() - started)
+        filter_matches += int(np.array_equal(actual[0], expected[0]) and actual[1] == expected[1])
+    print(dict(filter_bitwise_matches=filter_matches, filter_cases=200,
+               numpy_filter_ms=round(median(numpy_filter_times) * 1000, 3),
+               jit_filter_ms=round(median(jit_filter_times) * 1000, 3)))
+
+
+if __name__ == '__main__':
+    main()
