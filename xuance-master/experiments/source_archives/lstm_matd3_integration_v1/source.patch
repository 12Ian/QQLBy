+"""The optimized filter must reproduce the original safety decisions exactly."""
+from argparse import Namespace
+from pathlib import Path
+
+import numpy as np
+import pytest
+import yaml
+
+from xuance.environment.multi_agent_env.uav_pursuit_coverage_3d import UAVPursuitCoverage3DEnv
+from xuance.environment.multi_agent_env.uav_predictive_safety_3d import (
+    PredictiveSafetyFilter3D, _limit, _rollout_path_numba,
+)
+
+
+class OriginalFilter(PredictiveSafetyFilter3D):
+    """Frozen exp020/021 rollout and candidate selection, used as an oracle."""
+
+    def _rollout(self, commands):
+        env, dt = self.env, self.dt
+        count = commands.shape[1]
+        position = np.repeat(env.uav_positions[:, None, :], count, axis=1)
+        velocity = np.repeat(env.uav_velocities[:, None, :], count, axis=1)
+        acceleration = np.repeat(env.uav_accelerations[:, None, :], count, axis=1)
+        path = [position.copy()]
+        for index in range(self.steps):
+            p, v, a = (value.astype(np.float64) for value in (position, velocity, acceleration))
+            command = commands if index == 0 else self.brake(v, a)
+            command = _limit(command, env.max_accel)
+            jerk = _limit((command - a) / env.acceleration_lag, env.uav_jerk_max)
+            position = (p + v * dt + .5 * a * dt ** 2).astype(np.float32)
+            velocity = _limit(v + a * dt, env.uav_max_speed).astype(np.float32)
+            acceleration = _limit(a + jerk * dt, env.max_accel).astype(np.float32)
+            path.append(position.copy())
+        path = np.stack(path, axis=2)
+        z = np.stack([velocity, acceleration], axis=-1).astype(np.float64)
+        energy = np.einsum('...ki,ij,...kj->...', z, self.lyapunov, z)
+        scale = np.sqrt(np.maximum(energy, 0.))
+        bounds = scale[..., None] * self.tail_bounds
+        linear_tail = np.all(bounds <= np.array([
+            env.uav_max_speed, env.max_accel, env.max_accel, env.uav_jerk_max]), axis=-1)
+        radius = self.tail_gain * scale + .01
+        radius[~linear_tail] = np.inf
+        return path, radius
+
+    def filter(self, proposed):
+        env = self.env
+        proposed = np.asarray(proposed, dtype=np.float64)
+        if proposed.shape != (env.num_agents, 3) or not np.all(np.isfinite(proposed)):
+            raise ValueError('Safety filter requires finite three-axis commands')
+        proposed = _limit(proposed, env.max_accel)
+        brake = self.brake(env.uav_velocities.astype(np.float64),
+                           env.uav_accelerations.astype(np.float64))
+        commands = np.stack([proposed, brake], axis=1)
+        paths, radii = self._rollout(commands)
+        safe = self._individual_safe(paths, radii)
+        nominal = np.zeros(env.num_agents, dtype=int)
+        if self._joint_safe(paths, radii, safe, nominal):
+            return proposed.astype(np.float32), dict(certified=True, intervened=[False] * env.num_agents)
+        selected = np.ones(env.num_agents, dtype=int)
+        if not self._joint_safe(paths, radii, safe, selected):
+            return brake.astype(np.float32), dict(certified=False, intervened=(
+                np.linalg.norm(brake - proposed, axis=-1) > 1e-6).tolist())
+        axes = np.concatenate([np.eye(3), -np.eye(3)]) * env.max_accel
+        commands = np.concatenate([commands, np.zeros_like(proposed[:, None]),
+                                   proposed[:, None] * .5,
+                                   np.broadcast_to(axes, (env.num_agents, 6, 3))], axis=1)
+        paths, radii = self._rollout(commands)
+        safe = self._individual_safe(paths, radii)
+        for agent in range(env.num_agents):
+            cost = np.linalg.norm(commands[agent] - proposed[agent], axis=-1)
+            for candidate in np.argsort(cost, kind='stable'):
+                if safe[agent, candidate] and all(self._pair_safe(
+                        paths, radii, agent, other, candidate, selected[other])
+                        for other in range(env.num_agents) if other != agent):
+                    selected[agent] = candidate
+                    break
+        result = commands[np.arange(env.num_agents), selected].astype(np.float32)
+        return result, dict(certified=True, intervened=(
+            np.linalg.norm(result - proposed, axis=-1) > 1e-6).tolist())
+
+
+def make_environment(seed, hazard):
+    rng = np.random.default_rng(seed)
+    env = Namespace(num_agents=4, decision_dt=.5, physics_dt=.1,
+                    acceleration_lag=.5, max_accel=3., uav_jerk_max=6.,
+                    uav_max_speed=11., uav_radius=2., uav_collision_distance=4.,
+                    map_size=1000., z_min=0., z_max=400.)
+    env.uav_positions = np.column_stack((rng.uniform(30, 970, (4, 2)),
+                                         rng.uniform(20, 380, 4))).astype(np.float32)
+    env.uav_velocities = rng.uniform(-11, 11, (4, 3)).astype(np.float32)
+    env.uav_accelerations = rng.uniform(-3, 3, (4, 3)).astype(np.float32)
+    env.buildings = np.array([[430., 560., 410., 550., 240.]], np.float32)
+    if hazard == 'building':
+        env.uav_positions[:, :2] = [[420., 450.], [570., 450.], [500., 400.], [500., 560.]]
+    elif hazard == 'boundary':
+        env.uav_positions[:, 0] = [6., 994., 7., 993.]
+    elif hazard == 'pair':
+        env.uav_positions[:, :2] = [[450., 450.], [455., 450.], [500., 500.], [505., 500.]]
+    return env
+
+
+@pytest.mark.parametrize('hazard', ['random', 'building', 'boundary', 'pair'])
+def test_rollout_and_filter_match_original_bitwise(hazard):
+    for seed in range(20):
+        env = make_environment(seed, hazard)
+        config = Namespace(safety_margin=2., safety_horizon_seconds=8.)
+        original = OriginalFilter(env, config)
+        optimized = PredictiveSafetyFilter3D(env, config)
+        rng = np.random.default_rng(seed + 1000)
+        proposed = rng.uniform(-3., 3., (4, 3))
+        for count in (1, 2, 8, 10):
+            commands = rng.uniform(-3., 3., (4, count, 3))
+            expected_path, expected_radius = original._rollout(commands)
+            actual_path, actual_radius = optimized._rollout(commands)
+            np.testing.assert_array_equal(actual_path, expected_path)
+            np.testing.assert_array_equal(actual_radius, expected_radius)
+        expected_action, expected_certificate = original.filter(proposed)
+        actual_action, actual_certificate = optimized.filter(proposed)
+        np.testing.assert_array_equal(actual_action, expected_action)
+        assert actual_certificate == expected_certificate
+
+
+@pytest.mark.skipif(_rollout_path_numba is None, reason='numba is not installed')
+@pytest.mark.parametrize('hazard', ['random', 'building', 'boundary', 'pair'])
+def test_compiled_filter_matches_original_bitwise(hazard):
+    for seed in range(20):
+        env = make_environment(seed, hazard)
+        original = OriginalFilter(env, Namespace(safety_margin=2., safety_horizon_seconds=8.))
+        compiled = PredictiveSafetyFilter3D(
+            env, Namespace(safety_margin=2., safety_horizon_seconds=8., safety_rollout_backend='numba'))
+        proposed = np.random.default_rng(seed + 2000).uniform(-3., 3., (4, 3))
+        expected_action, expected_certificate = original.filter(proposed)
+        actual_action, actual_certificate = compiled.filter(proposed)
+        np.testing.assert_array_equal(actual_action, expected_action)
+        assert actual_certificate == expected_certificate
+
+
+@pytest.mark.parametrize('level', range(5))
+def test_five_curriculum_maps_match_original(level):
+    root = Path(__file__).resolve().parents[1]
+    config = yaml.safe_load((root / 'experiments/matd3_current_environment.yaml').read_text())
+    config.update(curriculum_start_level=level,
+                  buildings_dir=str(root / 'xuance/environment/multi_agent_env/buildings'))
+    env = UAVPursuitCoverage3DEnv(Namespace(**config))
+    try:
+        original = OriginalFilter(env, Namespace(**config))
+        for case in range(10):
+            env.seed(145001 + level * 1000 + case)
+            env.reset()
+            proposal = np.random.default_rng(case + level * 100).uniform(-3., 3., (4, 3))
+            commands = np.stack([proposal, np.zeros_like(proposal)], axis=1)
+            expected_path, expected_radius = original._rollout(commands)
+            actual_path, actual_radius = env.safety_filter._rollout(commands)
+            np.testing.assert_array_equal(actual_path, expected_path)
+            np.testing.assert_array_equal(actual_radius, expected_radius)
+            expected_action, expected_certificate = original.filter(proposal)
+            actual_action, actual_certificate = env.safety_filter.filter(proposal)
+            np.testing.assert_array_equal(actual_action, expected_action)
+            assert actual_certificate == expected_certificate
+    finally:
+        env.close()
