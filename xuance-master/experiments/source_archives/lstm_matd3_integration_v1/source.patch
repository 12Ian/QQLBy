 import math
 from collections import defaultdict, deque
 from pathlib import Path
+
+
+class BaselineTimingLog:
+    """Aggregate wall-clock costs once per training interval, not per step."""
+
+    def __init__(self, directory):
+        self.stream = (Path(directory) / "timing.csv").open("w", newline="", encoding="utf-8")
+        self.writer = csv.DictWriter(self.stream, fieldnames=["step", "name", "calls", "seconds"])
+        self.writer.writeheader()
+        self.seconds = defaultdict(float)
+        self.calls = defaultdict(int)
+
+    def add(self, name, seconds):
+        self.seconds[name] += seconds
+        self.calls[name] += 1
+
+    def flush(self, step):
+        for name in sorted(self.calls):
+            self.writer.writerow(dict(step=step, name=name, calls=self.calls[name],
+                                      seconds=f"{self.seconds[name]:.9f}"))
+        self.stream.flush()
+        self.seconds.clear()
+        self.calls.clear()
+
+    def close(self, step):
+        self.flush(step)
+        self.stream.close()
 
 
