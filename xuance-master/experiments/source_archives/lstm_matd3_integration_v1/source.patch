+"""Behavioral checks for typed graphs and the real MADDPG update interface."""
+from copy import deepcopy
+from argparse import Namespace
+
+import numpy as np
+import pytest
+import torch
+from gymnasium.spaces import Box
+from xuance.common import MultiAgentBaseCallback
+from xuance.torch.learners.multi_agent_rl.maddpg_learner import MADDPG_Learner
+from xuance.torch.policies.uav_hgat_maddpg import (
+    UAVGraphLayout, DirectedGATLayer, UAVHeteroGATEncoder, UAV_HGAT_MADDPG_Policy)
+
+
+KEYS = [f"agent_{i}" for i in range(4)]
+
+
+def observations(layout=UAVGraphLayout(), batch=3):
+    torch.manual_seed(27)
+    obs = torch.randn(batch * 4, layout.obs_dim) * .2
+    if layout.building_k:
+        obs[:, layout.building_start + 5::6] = 1
+        obs[:, -1] = 0  # padded last building
+    return obs
+
+
+def policy(layout=UAVGraphLayout(), critic_hgat=True, device="cpu"):
+    torch.manual_seed(13)
+    return UAV_HGAT_MADDPG_Policy(
+        {key: Box(-1., 1., (3,)) for key in KEYS}, layout, [32, 32], [32, 32], [KEYS[0]],
+        critic_hgat=critic_hgat, device=device)
+
+
+def ids(batch=3, device="cpu"):
+    return torch.eye(4, device=device).repeat(batch, 1)
+
+
+@pytest.mark.parametrize("context,predictions,k", [(4, 0, 5), (0, 5, 5), (4, 5, 0), (0, 0, 0)])
+def test_layout_dimensions_and_optional_fields(context, predictions, k):
+    layout = UAVGraphLayout(context_dim=context, prediction_steps=predictions, building_k=k)
+    obs = observations(layout)
+    nodes, valid, edges, ego = layout.build(obs)
+    assert nodes.shape == (12, layout.node_count, layout.feature_dim)
+    assert ego.shape[-1] == 17 + context
+    assert torch.equal(ego[:, 11:17], obs[:, layout.mate_end:layout.target_start])
+    with pytest.raises(ValueError, match="layout"):
+        layout.build(obs[:, :-1])
+    encoded = UAVHeteroGATEncoder(layout)(obs)["state"]
+    assert encoded.shape == (12, 17 + context + 32)
+    assert torch.isfinite(encoded).all()
+
+
+def test_directed_edges_and_two_hop_message():
+    nodes, valid, edges, _ = UAVGraphLayout().build(observations())
+    assert edges[0, 0, 5] and edges[0, 1, 5]  # building -> moving
+    assert not edges[0, 5, 0] and not edges[0, 5, 1]
+    assert edges[0, 0, 4] and edges[0, 4, 0]  # reciprocal target response
+    assert not edges[0, -1, :].any() and not edges[0, :, -1].any()
+    # Three nodes: building can reach ego only through teammate in two layers.
+    layer = DirectedGATLayer(1, 1)
+    with torch.no_grad():
+        layer.projection.weight.fill_(1)
+        layer.receiver_score.weight.zero_()
+        layer.sender_score.weight.zero_()
+    graph = torch.tensor([[[1, 1, 0], [0, 1, 1], [0, 0, 1]]], dtype=torch.bool)
+    x = torch.tensor([[[0.], [0.], [8.]]])
+    first, _ = layer(x, graph)
+    second, _ = layer(first, graph)
+    assert first[0, 0, 0] == 0 and second[0, 0, 0] > 0
+
+
+def test_mask_before_softmax_and_empty_graph():
+    layer = DirectedGATLayer(1, 1)
+    with torch.no_grad():
+        for parameter in layer.parameters():
+            parameter.fill_(1)
+    edges = torch.tensor([[[1, 0], [0, 0]]], dtype=torch.bool)
+    output, attention = layer(torch.tensor([[[2.], [1e20]]]), edges)
+    assert output[0, 0, 0] == 2
+    assert attention[0, 0, 0] == 1
+    assert not attention[0, 1].any() and not output[0, 1].any()
+    output, attention = layer(torch.randn(2, 4, 1), torch.zeros(2, 4, 4, dtype=torch.bool))
+    assert not output.any() and not attention.any()
+    p = policy()
+    obs = observations()
+    obs[:, p.layout.building_start + 5::6] = 0
+    obs_nan_padding = obs.clone()
+    buildings = obs_nan_padding[:, p.layout.building_start:].reshape(-1, 5, 6)
+    buildings[..., :5] = float("nan")
+    a = p({KEYS[0]: obs}, ids())[1][KEYS[0]]
+    a_padding = p({KEYS[0]: obs_nan_padding}, ids())[1][KEYS[0]]
+    torch.testing.assert_close(a, a_padding)
+
+
+def test_end_to_end_node_permutation_and_batch_independence():
+    p = policy()
+    layout = p.layout
+    obs = observations()
+    shuffled = obs.clone()
+    shuffled[:, 11:layout.mate_end] = obs[:, 11:layout.mate_end].reshape(-1, 3, 6)[:, [2, 0, 1]].flatten(1)
+    shuffled[:, layout.building_start:] = obs[:, layout.building_start:].reshape(-1, 5, 6)[:, [4, 2, 0, 3, 1]].flatten(1)
+    action = p({KEYS[0]: obs}, ids())[1][KEYS[0]]
+    torch.testing.assert_close(action, p({KEYS[0]: shuffled}, ids())[1][KEYS[0]], atol=2e-6, rtol=1e-5)
+    q = p.Qpolicy(obs.reshape(3, -1), action.reshape(3, -1), ids())[1][KEYS[0]]
+    qs = p.Qpolicy(shuffled.reshape(3, -1), action.reshape(3, -1), ids())[1][KEYS[0]]
+    torch.testing.assert_close(q, qs, atol=2e-6, rtol=1e-5)
+    for i in range(3):
+        single_action = p({KEYS[0]: obs[i * 4:(i + 1) * 4]}, ids(1))[1][KEYS[0]]
+        single_q = p.Qpolicy(obs[i * 4:(i + 1) * 4].reshape(1, -1), single_action.reshape(1, -1),
+                             ids(1))[1][KEYS[0]]
+        torch.testing.assert_close(single_action, action[i * 4:(i + 1) * 4])
+        torch.testing.assert_close(single_q, q[i * 4:(i + 1) * 4])
+
+
+def test_decentralized_actor_and_centralized_action_gradient():
+    p = policy()
+    obs = observations()
+    a = p({KEYS[0]: obs}, ids())[1][KEYS[0]]
+    altered = obs.clone()
+    altered[1:4] += .5
+    torch.testing.assert_close(a[0], p({KEYS[0]: altered}, ids())[1][KEYS[0]][0])
+    joint_a = a.detach().reshape(3, -1).requires_grad_()
+    q = p.Qpolicy(obs.reshape(3, -1), joint_a, ids())[1][KEYS[0]]
+    grad = torch.autograd.grad(q[0], joint_a)[0]
+    assert grad[0, 3:].abs().sum() > 0  # Q_0 receives other agents' actions
+    assert not grad[1:].any()  # no cross-environment dependence
+    assert a.abs().max() <= 1
+
+
+@pytest.mark.parametrize("critic_hgat", [True, False])
+def test_real_learner_updates_disjoint_encoders_and_targets(critic_hgat, tmp_path):
+    p = policy(critic_hgat=critic_hgat)
+    config = Namespace(distributed_training=False, n_agents=4, use_parameter_sharing=True,
+                       episode_length=32, device="cpu", use_grad_clip=True, grad_clip_norm=.5,
+                       running_steps=1024, start_training=32, training_frequency=1, parallels=2,
+                       model_dir="unused", learning_rate_actor=1e-3, learning_rate_critic=1e-3,
+                       gamma=.99, tau=.1, end_factor_lr_decay=1.)
+    learner = MADDPG_Learner(config, [KEYS[0]], KEYS, p, MultiAgentBaseCallback())
+    actor_params, critic_params = p.parameters_actor[KEYS[0]], p.parameters_critic[KEYS[0]]
+    actor_ids, critic_ids = set(map(id, actor_params)), set(map(id, critic_params))
+    assert not actor_ids & critic_ids
+    assert len(actor_ids) == len(actor_params) and len(critic_ids) == len(critic_params)
+    assert all(not x.requires_grad for x in p.target_actor_representation.parameters())
+    obs = observations().reshape(3, 4, -1).numpy()
+    sample = {"batch_size": 3,
+              "obs": {k: obs[:, i] for i, k in enumerate(KEYS)},
+              "obs_next": {k: obs[:, i] * .9 for i, k in enumerate(KEYS)},
+              "actions": {k: np.ones((3, 3), np.float32) * .1 for k in KEYS},
+              "rewards": {k: np.ones(3, np.float32) for k in KEYS},
+              "terminals": {k: np.zeros(3, np.float32) for k in KEYS},
+              "agent_mask": {k: np.ones(3, np.float32) for k in KEYS}}
+    before = deepcopy(p.state_dict())
+    metrics = learner.update(sample)
+    assert all(np.isfinite(value) for value in metrics.values())
+    for prefix in ("actor_representation", "critic_representation"):
+        parameters = list(getattr(p, prefix).parameters())
+        if not parameters:
+            continue
+        assert sum(x.grad.abs().sum().item() for x in parameters if x.grad is not None) > 0
+        assert any(not torch.equal(value, before[name]) for name, value in p.state_dict().items()
+                   if name.startswith(prefix))
+    for name, updated in p.state_dict().items():
+        if name.startswith("target_"):
+            source = name.removeprefix("target_")
+            torch.testing.assert_close(updated, .9 * before[name] + .1 * p.state_dict()[source])
+    filename = tmp_path / "learner_checkpoint.pth"
+    learner.save_model(str(filename))
+    restored_policy = policy(critic_hgat=critic_hgat)
+    restored = MADDPG_Learner(config, [KEYS[0]], KEYS, restored_policy, MultiAgentBaseCallback())
+    restored.load_model(str(filename))
+    for original, reloaded in zip(p.parameters(), restored_policy.parameters()):
+        torch.testing.assert_close(original, reloaded, rtol=0, atol=0)
+    for group in ("actor", "critic"):
+        states = restored.optimizer[KEYS[0]][group].state_dict()["state"]
+        assert states and all(value["step"] == 1 for value in states.values())
+    assert all(np.isfinite(value) for value in restored.update(sample).values())
+
+
+def test_checkpoint_round_trip_and_architecture_rejection(tmp_path):
+    p, obs = policy(), observations()
+    filename = tmp_path / "hgat.pth"
+    torch.save(p.state_dict(), filename)
+    restored = policy()
+    restored.load_state_dict(torch.load(filename, weights_only=True))
+    torch.testing.assert_close(p({KEYS[0]: obs}, ids())[1][KEYS[0]],
+                               restored({KEYS[0]: obs}, ids())[1][KEYS[0]], rtol=0, atol=0)
+    action = p({KEYS[0]: obs}, ids())[1][KEYS[0]].reshape(3, -1)
+    torch.testing.assert_close(p.Qpolicy(obs.reshape(3, -1), action, ids())[1][KEYS[0]],
+                               restored.Qpolicy(obs.reshape(3, -1), action, ids())[1][KEYS[0]], rtol=0, atol=0)
+    with pytest.raises(ValueError, match="mismatch"):
+        policy(UAVGraphLayout(context_dim=0)).load_state_dict(p.state_dict(), strict=False)
+    missing = deepcopy(p.state_dict())
+    missing.pop("target_actor_representation.agent_0.layer1.projection.weight")
+    with pytest.raises(RuntimeError, match="Missing key"):
+        restored.load_state_dict(missing, strict=False)
+
+
+@pytest.mark.parametrize("actor_only", [False, True])
+def test_baseline_warm_start_loads_graph_weights(tmp_path, actor_only):
+    from xuance.engine.run_marl import initialize_baseline_policy
+    original, restored = policy(), policy()
+    with torch.no_grad():
+        for parameter in original.parameters_actor[KEYS[0]]:
+            parameter.add_(.1)
+    filename = tmp_path / "trained_hgat.pth"
+    torch.save({"policy": original.state_dict()}, filename)
+    agent = Namespace(policy=restored, device="cpu")
+    config = Namespace(policy="UAV_HGAT_MADDPG_Policy", baseline_init_actor=str(filename) if actor_only else None,
+                       baseline_init_checkpoint=None if actor_only else str(filename))
+    audit = initialize_baseline_policy(agent, config)
+    assert not audit["optimizer_restored"]
+    for before, after in zip(original.parameters_actor[KEYS[0]], restored.parameters_actor[KEYS[0]]):
+        torch.testing.assert_close(before, after)
+
+
+@pytest.mark.parametrize("gat_o", [False, True])
+def test_existing_maddpg_mlp_and_gat_o_modes(gat_o):
+    from xuance.torch.policies.deterministic_marl import MADDPG_Policy
+    from xuance.torch.representations import Basic_Identical
+    p = MADDPG_Policy(
+        action_space={key: Box(-1., 1., (3,)) for key in KEYS}, n_agents=4,
+        actor_representation=torch.nn.ModuleDict({KEYS[0]: Basic_Identical((79,), device="cpu")}),
+        critic_representation=torch.nn.ModuleDict({KEYS[0]: Basic_Identical((328,), device="cpu")}),
+        actor_hidden_size=[32], critic_hidden_size=[32], activation=torch.nn.LeakyReLU,
+        activation_action=torch.nn.Tanh, device="cpu", use_parameter_sharing=True,
+        model_keys=[KEYS[0]], use_rnn=False, rnn=None, use_obstacle_gat=gat_o,
+        obstacle_gat_k=5, obstacle_gat_feat_dim=6, obstacle_gat_hidden=32, obstacle_gat_heads=2)
+    obs = observations()
+    action = p({KEYS[0]: obs}, ids())[1][KEYS[0]]
+    q = p.Qpolicy(obs.reshape(3, -1), action.reshape(3, -1), ids())[1][KEYS[0]]
+    q.sum().backward()
+    p.soft_update(.1)
+    assert action.shape == (12, 3) and torch.isfinite(q).all()
+    if gat_o:
+        assert sum(x.grad.abs().sum().item() for x in p.obstacle_gat.parameters() if x.grad is not None) > 0
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA unavailable")
+def test_cuda_matches_cpu():
+    cpu, gpu = policy(), policy(device="cuda:0")
+    gpu.load_state_dict(cpu.state_dict())
+    obs = observations()
+    action_cpu = cpu({KEYS[0]: obs}, ids())[1][KEYS[0]]
+    action_gpu = gpu({KEYS[0]: obs.numpy()}, ids())[1][KEYS[0]]
+    torch.testing.assert_close(action_cpu, action_gpu.cpu(), atol=2e-6, rtol=1e-5)
