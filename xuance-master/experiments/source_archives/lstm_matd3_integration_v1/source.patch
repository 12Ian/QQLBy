+"""Exercise the actual benchmark loop with a deterministic CPU-only agent double."""
+from argparse import Namespace
+import ast
+from copy import deepcopy
+import csv
+import importlib.util
+import json
+import os
+from pathlib import Path
+import sys
+import time
+from types import ModuleType
+
+import numpy as np
+import pytest
+
+
+ENGINE = Path(__file__).resolve().parents[1] / 'xuance/engine'
+
+
+def load_loop(path, monkeypatch):
+    package = ModuleType('isolated_uav_benchmark')
+    package.__path__ = [str(ENGINE)]
+    monkeypatch.setitem(sys.modules, package.__name__, package)
+    for name in ['uav_curriculum', 'uav_baseline_logging']:
+        qualified = package.__name__ + '.' + name
+        spec = importlib.util.spec_from_file_location(qualified, ENGINE / (name + '.py'))
+        module = importlib.util.module_from_spec(spec)
+        monkeypatch.setitem(sys.modules, qualified, module)
+        spec.loader.exec_module(module)
+    tree = ast.parse(path.read_text(encoding='utf-8'))
+    runner = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == 'RunnerMARL')
+    method = next(node for node in runner.body if isinstance(node, ast.FunctionDef) and node.name == '_run_baseline_benchmark')
+    namespace = dict(__package__=package.__name__, os=os, json=json, time=time,
+                     csv=csv, np=np, deepcopy=deepcopy,
+                     create_directory=lambda path: Path(path).mkdir(parents=True, exist_ok=True),
+                     initialize_baseline_policy=lambda *args: None,
+                     make_envs=lambda config: Namespace(env_method=lambda *args: None,
+                                                       close=lambda: None))
+    exec(compile(ast.Module(body=[method], type_ignores=[]), str(path), 'exec'), namespace)
+    return namespace['_run_baseline_benchmark']
+
+
+class AgentDouble:
+    def __init__(self, config):
+        self.config = config
+        self.current_step = 0
+        self.distributed_training = False
+        self.use_wandb = False
+        self.writer = Namespace(flush=lambda: None)
+        self.train_envs = Namespace(env_method=lambda *args: None)
+        self.saved = []
+
+    def train(self, train_steps):
+        self.current_step += train_steps * 16
+
+    def save_model(self, model_name, **kwargs):
+        self.saved.append((self.current_step, model_name))
+
+    def log_infos(self, *args):
+        pass
+
+    def run_episodes(self, n_episodes, curriculum_level, **kwargs):
+        self.last_test_metrics = dict(
+            episodes=n_episodes, success_rate=1., safe_success_rate=1., collision_rate=0.,
+            building_collision_rate=0., boundary_collision_rate=0., uav_collision_rate=0.,
+            mean_episode_steps=100.)
+        return np.ones(n_episodes)
+
+
+def run_case(tmp_path, monkeypatch, source='run_marl.py', retention=250000,
+             budget=600000, interval=50000, level=4, checkpoint=None,
+             final_interval=250000, all_levels=False):
+    config = Namespace(
+        running_steps=budget, eval_interval=interval, test_episode=100,
+        baseline_final_eval_interval=final_interval, baseline_evaluate_previous_levels=True,
+        curriculum_eval_all_levels=all_levels,
+        baseline_eval_parallels=8, curriculum_schedule=[{}] * 5, curriculum_enabled=True,
+        curriculum_start_level=level, curriculum_min_steps_per_level=100000,
+        seed=1, env_seed=1, result_dir=str(tmp_path))
+    if retention is not None:
+        config.baseline_retention_eval_interval = retention
+    if checkpoint is not None:
+        config.baseline_checkpoint_interval = checkpoint
+    agent = AgentDouble(config)
+    runner = Namespace(config=config, agent=agent, n_envs=16, rprint=lambda *args: None)
+    load_loop(ENGINE / source, monkeypatch)(runner)
+    with (tmp_path / 'curriculum_eval.csv').open() as stream:
+        rows = list(csv.DictReader(stream))
+    summary = json.loads((tmp_path / 'baseline_summary.json').read_text())
+    return rows, summary, agent.saved
+
+
+def test_current_evaluation_keeps_50k_cadence_and_retention_uses_250k(tmp_path, monkeypatch):
+    rows, summary, _ = run_case(tmp_path, monkeypatch)
