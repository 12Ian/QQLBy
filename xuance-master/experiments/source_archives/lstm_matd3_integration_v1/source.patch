+    def _twin_values(self, joint_observation, joint_actions, agent_ids, target, agent_key=None):
+        observations, actions = self._tensor(joint_observation), self._tensor(joint_actions)
+        if observations.ndim != 2 or observations.shape[-1] != self.n_agents * self.layout.obs_dim:
+            raise ValueError("UAV HGAT critic requires batched joint observations in agent order")
+        batch = observations.shape[0]
+        if actions.shape != (batch, 3 * self.n_agents):
+            raise ValueError("UAV HGAT critic requires all joint acceleration actions")
+        ids = self._tensor(agent_ids)
+        twin = []
+        for branch in ("A", "B"):
+            prefix = "target_critic_" if target else "critic_"
+            representations = getattr(self, prefix + branch + "_representation")
+            heads = getattr(self, prefix + branch)
+            values = {}
+            for key in ([agent_key] if agent_key else self.model_keys):
+                state = (representations[key](observations.reshape(batch * self.n_agents, self.layout.obs_dim))[
+                    "state"].reshape(batch, -1) if self.critic_hgat else observations)
+                joint = torch.cat((state, actions), dim=-1)
+                joint = joint.unsqueeze(1).expand(-1, self.n_agents, -1).reshape(batch * self.n_agents, -1)
+                values[key] = heads[key](torch.cat((joint, ids), dim=-1))
+            twin.append(values)
+        return twin
+
+    def Qpolicy(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        q_a, q_b = self._twin_values(joint_observation, joint_actions, agent_ids, False, agent_key)
+        return q_a, q_b, {key: (q_a[key] + q_b[key]) * .5 for key in q_a}
+
+    def Qtarget(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        q_a, q_b = self._twin_values(joint_observation, joint_actions, agent_ids, True, agent_key)
+        return {key: torch.minimum(q_a[key], q_b[key]) for key in q_a}
