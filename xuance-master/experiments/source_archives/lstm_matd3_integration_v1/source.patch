+"""Replay a fixed case while checking every safety decision against exp020/021."""
+import argparse
+from argparse import Namespace
+from importlib.util import module_from_spec, spec_from_file_location
+import json
+from pathlib import Path
+
+import numpy as np
+
+from tools import evaluate_matd3_fixed_cases as evaluator
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', type=Path, required=True)
+    parser.add_argument('--checkpoint', type=Path, required=True)
+    parser.add_argument('--level', type=int, choices=range(5), required=True)
+    parser.add_argument('--case', type=int, default=0)
+    parser.add_argument('--seed-base', type=int, default=145001)
+    args = parser.parse_args()
+    tests = Path(__file__).resolve().parents[1] / 'tests/test_uav_safety_rollout_parity.py'
+    spec = spec_from_file_location('safety_parity_oracle', tests)
+    module = module_from_spec(spec)
+    spec.loader.exec_module(module)
+    evaluator.initialize(args.config.resolve(), args.checkpoint.resolve(), args.level)
+    try:
+        env = evaluator._env
+        reference = module.OriginalFilter(
+            env, Namespace(safety_margin=env.safety_filter.margin,
+                           safety_horizon_seconds=env.safety_filter.horizon))
+        optimized_filter = env.safety_filter.filter
+        checked = 0
+
+        def filter_and_compare(proposed):
+            nonlocal checked
+            expected_action, expected_certificate = reference.filter(proposed)
+            actual_action, actual_certificate = optimized_filter(proposed)
+            if not np.array_equal(actual_action, expected_action) or actual_certificate != expected_certificate:
+                raise AssertionError(f'Safety decision differs at filter call {checked}')
+            checked += 1
+            return actual_action, actual_certificate
+
+        env.safety_filter.filter = filter_and_compare
+        result = evaluator.episode((args.case, args.seed_base + args.level * 1000 + args.case))
+        print(json.dumps(dict(level=args.level, case=args.case, filter_calls_checked=checked,
+                              result=result), ensure_ascii=False))
+    finally:
+        evaluator.cleanup()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/xuance-master/tools/evaluate_matd3_fixed_cases.py b/xuance-master/tools/evaluate_matd3_fixed_cases.py
new file mode 100644
--- /dev/null
+++ b/xuance-master/tools/evaluate_matd3_fixed_cases.py
@@ -0,0 +1,151 @@
+"""Evaluate either MATD3 policy on identical, explicitly seeded episode cases."""
+import argparse
+from argparse import Namespace
+from concurrent.futures import ProcessPoolExecutor, as_completed
+import hashlib
+import json
+import multiprocessing as mp
+from multiprocessing.util import Finalize
+from pathlib import Path
+import time
+
+import numpy as np
+import torch
+import yaml
+from xuance import get_runner
+from xuance.environment.multi_agent_env.uav_pursuit_coverage_3d import UAVPursuitCoverage3DEnv
+
+
+_runner = _env = _policy = None
+_config = None
+
+
+def cleanup():
+    if _env is not None:
+        _env.close()
+    if _runner is not None:
+        _runner.agent.train_envs.close()
+        _runner.agent.finish()
+
+
+def initialize(config_path, checkpoint_path, level):
+    global _runner, _env, _policy, _config
+    torch.set_num_threads(1)
+    _config = yaml.safe_load(Path(config_path).read_text(encoding="utf-8"))
+    if _config.get("baseline_evaluate_full_episode", True):
+        raise ValueError("This comparison requires collision-terminating evaluation")
+    if not all(_config.get(key, False) for key in
+               ("terminate_on_building_collision", "terminate_on_boundary_collision")):
+        raise ValueError("Building and boundary collisions must terminate evaluation")
+    name = f"fixed_cases_{mp.current_process().pid}_{level}"
+    options = Namespace(env_id=name, device="cpu", parallels=1, vectorize="DummyVecMultiAgentEnv",
+                        buffer_size=128, batch_size=32, render=False, curriculum_start_level=level,
+                        baseline_init_actor=None, baseline_init_checkpoint=None)
+    _runner = get_runner("matd3", "uav_pursuit_coverage_3d", name,
+                         config_path=config_path, parser_args=options)
+    _policy = _runner.agent.policy
+    saved = torch.load(checkpoint_path, map_location="cpu", weights_only=True)["policy"]
+    if not all(torch.isfinite(value).all() for value in saved.values() if torch.is_tensor(value)):
+        raise ValueError("Non-finite checkpoint")
+    _policy.load_state_dict(saved, strict=True)
+    _policy.eval()
+    _env = UAVPursuitCoverage3DEnv(Namespace(**dict(_config, curriculum_start_level=level, render=False)))
+    Finalize(None, cleanup, exitpriority=10)
+
+
+def episode(case_and_seed):
+    case, seed = case_and_seed
+    _env.seed(seed)
+    obs, _ = _env.reset()
+    keys = _env.agents
+    initial = dict(buildings_sha256=hashlib.sha256(_env.buildings.tobytes()).hexdigest(),
+                   positions=_env.uav_positions.tolist(), velocities=_env.uav_velocities.tolist(),
+                   accelerations=_env.uav_accelerations.tolist(), target_position=_env.target_position.tolist(),
+                   target_velocity=_env.target_velocity.tolist(), target_acceleration=_env.target_acceleration.tolist(),
+                   observations={key: obs[key].tolist() for key in keys})
+    initial_sha256 = hashlib.sha256(json.dumps(initial, sort_keys=True).encode()).hexdigest()
+    ids = torch.eye(len(keys))
+    total_return = 0.0
+    for step in range(1, _env.max_episode_steps + 1):
+        inputs = torch.as_tensor(np.stack([obs[key] for key in keys]), dtype=torch.float32)
+        with torch.inference_mode():
+            actions = _policy({keys[0]: inputs}, agent_ids=ids)[1][keys[0]].cpu().numpy()
+        if not np.isfinite(actions).all() or np.max(np.abs(actions)) > 1.000001:
+            raise ValueError("Invalid deterministic policy actions")
+        obs, rewards, terminated, truncated, info = _env.step(
+            {key: actions[i] for i, key in enumerate(keys)})
+        total_return += float(np.mean(list(rewards.values())))
+        diagnostic = info["infos"]
+        building = bool(info.get("is_building_collision", False)) or diagnostic["building_contact_events_episode"] > 0
+        boundary = bool(info.get("is_boundary_collision", False)) or diagnostic["boundary_contact_events_episode"] > 0
+        uav = bool(_config["uav_collision_enabled"] and diagnostic["uav_contact_events_episode"] > 0)
+        collision = building or boundary or uav
+        done = all(terminated.values()) or bool(truncated)
+        if collision and not done:
+            raise AssertionError("Configured collision did not terminate the episode")
+        if done:
+            return dict(case=case, env_seed=seed, initial_sha256=initial_sha256, steps=step,
+                        success=bool(info["is_success"]), safe_success=bool(info["is_success"] and not collision),
+                        collision=collision, building_collision=building, boundary_collision=boundary,
+                        uav_collision=uav, timeout=bool(truncated), mean_return=total_return,
+                        capture_time=float(info["capture_time"]) if info["capture_time"] is not None else None,
+                        safety_checks=diagnostic["safety_checks_episode"],
+                        safety_interventions=diagnostic["safety_interventions_episode"],
+                        uncertified_substeps=diagnostic["safety_uncertified_substeps_episode"],
+                        target_building_contacts=diagnostic.get("target_building_contacts_episode", 0))
+    raise AssertionError("Environment exceeded its episode budget")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--checkpoint", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--level", type=int, choices=range(5), required=True)
+    parser.add_argument("--seed-base", type=int, default=145001)
+    parser.add_argument("--episodes", type=int, default=100)
+    parser.add_argument("--workers", type=int, default=8)
+    args = parser.parse_args()
+    if min(args.episodes, args.workers) < 1 or args.output.exists():
+        parser.error("Use positive counts and a fresh output file")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    config = str(args.config.resolve())
+    checkpoint = str(args.checkpoint.resolve())
+    jobs = [(i, args.seed_base + args.level * 1000 + i) for i in range(args.episodes)]
+    records = []
+    started = time.time()
+    with args.output.with_suffix(".cases.jsonl").open("x", encoding="utf-8") as stream:
+        with ProcessPoolExecutor(max_workers=min(args.workers, args.episodes), mp_context=mp.get_context("spawn"),
+                                 initializer=initialize, initargs=(config, checkpoint, args.level)) as executor:
+            futures = [executor.submit(episode, job) for job in jobs]
+            for future in as_completed(futures):
+                record = future.result()
+                stream.write(json.dumps(record, allow_nan=False) + "\n")
+                stream.flush()
+                records.append(record)
+                if len(records) % 20 == 0 or len(records) == args.episodes:
+                    print(f"[fixed eval] level={args.level} episodes={len(records)}/{args.episodes}", flush=True)
+    records.sort(key=lambda value: value["case"])
+    metrics = {name + "_rate": float(np.mean([record[name] for record in records])) for name in
+               ("success", "safe_success", "collision", "building_collision", "boundary_collision", "uav_collision", "timeout")}
+    metrics.update(episodes=len(records), mean_episode_steps=float(np.mean([r["steps"] for r in records])))
+    checks = sum(r["safety_checks"] for r in records)
+    interventions = sum(r["safety_interventions"] for r in records)
+    cfg = yaml.safe_load(args.config.read_text(encoding="utf-8"))
+    result = dict(level=args.level, metrics=metrics, episodes=records, inference_device="cpu",
+                  seed_protocol="seed_base + level*1000 + case_index", seed_base=args.seed_base,
+                  exploration_noise=False, max_episode_steps=cfg["episode_length"],
+                  uav_collision_enabled=cfg["uav_collision_enabled"], collision_termination=True,
+                  safety_metrics=dict(checks=checks, interventions=interventions,
+                                      intervention_fraction=interventions / checks if checks else None,
+                                      uncertified_substeps=sum(r["uncertified_substeps"] for r in records)),
+                  target_building_contact_rate=float(np.mean([r["target_building_contacts"] > 0 for r in records])),
+                  checkpoint=checkpoint, checkpoint_sha256=hashlib.sha256(args.checkpoint.read_bytes()).hexdigest(),
+                  elapsed_seconds=time.time() - started)
+    with args.output.open("x", encoding="utf-8") as stream:
+        json.dump(result, stream, ensure_ascii=False, indent=2, allow_nan=False)
+    print(json.dumps(dict(output=str(args.output), metrics=metrics)), flush=True)
+
+
+if __name__ == "__main__":
+    main()
