+            assert any(not torch.equal(value, before[key]) for key, value in p.state_dict().items()
+                       if key.startswith(name + "."))
+    second = learn.update(sample())
+    assert f"{KEYS[0]}/loss_actor" in second
+    assert all(np.isfinite(value) for value in second.values())
+    assert any(not torch.equal(value, before[name]) for name, value in p.state_dict().items()
+               if name.startswith("actor_representation."))
+    for name, value in p.state_dict().items():
+        if name.startswith("target_"):
+            torch.testing.assert_close(value, .9 * before[name] + .1 * p.state_dict()[name.removeprefix("target_")])
