+"""The approved 300-second profile keeps timeout and evaluation semantics."""
+from argparse import Namespace
+import importlib.util
+from pathlib import Path
+import sys
+
+import numpy as np
+import pytest
+import yaml
+
+from xuance.environment.multi_agent_env.uav_pursuit_coverage_3d import UAVPursuitCoverage3DEnv
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def profiles():
+    return [yaml.safe_load((ROOT / 'experiments' / name).read_text()) for name in
+            ('matd3_600step_v3.yaml', 'matd3_hgat_600step_v3.yaml')]
+
+
+def test_paired_profiles_keep_budget_safety_gate_and_evaluation_protocol():
+    a, b = profiles()
+    assert {k for k in a if a[k] != b[k]} == {'policy', 'env_id'}
+    for config in (a, b):
+        assert config['episode_length'] == 600
+        assert config['episode_length'] * config['decision_dt'] == 300.
+        assert config['eval_interval'] == 200000 and config['test_episode'] == 100
+        assert config['baseline_final_eval_interval'] == config['baseline_retention_eval_interval'] == 1000000
+        assert config['baseline_checkpoint_interval'] == 50000
+        assert config['curriculum_required_passes'] == 2 and config['curriculum_success_threshold'] == .8
+        assert config['curriculum_collision_threshold'] == .1
+        assert config['curriculum_eval_all_levels'] and config['baseline_evaluate_previous_levels']
+        assert config['running_steps'] == 6000000 and config['parallels'] == 16 and config['seed'] == 1
+        assert config['baseline_eval_parallels'] == 16 and config['safety_rollout_backend'] == 'numba'
+        assert config['safety_horizon_seconds'] == 8.
+        assert config['terminate_on_building_collision'] and config['terminate_on_boundary_collision']
+        assert not config['uav_collision_enabled'] and not config['baseline_evaluate_full_episode']
+        assert [stage['target_max_speed'] for stage in config['curriculum_schedule']] == [3, 5, 8, 10, 12]
+
+
+@pytest.mark.parametrize('profile_index', [0, 1])
+def test_step_600_is_timeout_without_becoming_a_collision(profile_index):
+    config = profiles()[profile_index]
+    config.update(safety_rollout_backend='numpy', buildings_dir=str(
+        ROOT / 'xuance/environment/multi_agent_env/buildings'))
+    env = UAVPursuitCoverage3DEnv(Namespace(**config))
+    try:
+        env.reset()
+        env.buildings = np.empty((0, 5), dtype=np.float32)
+        env.target_position = np.array([500, 500, 200], dtype=np.float32)
+        env.target_velocity.fill(0)
+        env.target_acceleration.fill(0)
+        env.uav_positions = np.array([[600 + 20*i, 500, 200] for i in range(4)], dtype=np.float32)
+        env.uav_velocities.fill(0)
+        env.uav_accelerations.fill(0)
+        env._evader_control = lambda *args, **kwargs: np.zeros(3, dtype=np.float32)
+        env._episode_step = 598
+        env.episode_elapsed_seconds = 299.
+        actions = {agent: np.zeros(3) for agent in env.agents}
+        _, _, done, truncated, _ = env.step(actions)
+        assert not any(done.values()) and not truncated
+        _, _, done, truncated, info = env.step(actions)
+        assert not any(done.values()) and truncated
+        assert not info['is_success'] and not info['is_collision']
+        assert env._episode_step == 600 and env.episode_elapsed_seconds == pytest.approx(300.)
+    finally:
+        env.close()
+
+
+@pytest.mark.parametrize('interval', [None, 400000])
+def test_training_entry_preserves_yaml_interval_without_an_explicit_override(monkeypatch, interval):
+    spec = importlib.util.spec_from_file_location('run_600step_baseline', ROOT / 'examples/run_baseline.py')
+    entry = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(entry)
+    observed = {}
+
+    def get_runner(*args, **kwargs):
+        observed.update(kwargs)
+        return Namespace(run=lambda **options: None)
+
+    monkeypatch.setattr(entry, 'get_runner', get_runner)
+    argv = ['run_baseline.py', '--config', str(ROOT / 'experiments/matd3_600step_v3.yaml'),
+            '--name', '600step_cli_test']
+    if interval is not None:
+        argv.extend(['--eval-interval', str(interval)])
+    monkeypatch.setattr(sys, 'argv', argv)
+    entry.main()
+    overrides = vars(observed['parser_args'])
+    config = yaml.safe_load(Path(observed['config_path']).read_text())
+    assert overrides.get('eval_interval', config['eval_interval']) == (200000 if interval is None else interval)
