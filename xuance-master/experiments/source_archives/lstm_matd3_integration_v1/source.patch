+"""HGAT must preserve MATD3's independent twin critics and update semantics."""
+from argparse import Namespace
+from copy import deepcopy
+
+import numpy as np
+import pytest
+import torch
+from gymnasium.spaces import Box
+from xuance.common import MultiAgentBaseCallback
+from xuance.torch.learners.multi_agent_rl.matd3_learner import MATD3_Learner
+from xuance.torch.policies.uav_hgat_maddpg import UAVGraphLayout
+from xuance.torch.policies.uav_hgat_matd3 import UAV_HGAT_MATD3_Policy
+from test_uav_hgat_maddpg import KEYS, ids, observations, policy as maddpg_policy
+
+
+def policy(critic_hgat=True, device="cpu"):
+    torch.manual_seed(51)
+    return UAV_HGAT_MATD3_Policy(
+        {key: Box(-1., 1., (3,)) for key in KEYS}, UAVGraphLayout(), [32, 32], [32, 32], [KEYS[0]],
+        critic_hgat=critic_hgat, device=device)
+
+
+def learner(p):
+    config = Namespace(distributed_training=False, n_agents=4, use_parameter_sharing=True,
+                       episode_length=32, device="cpu", use_grad_clip=True, grad_clip_norm=.5,
+                       running_steps=1024, start_training=32, training_frequency=1, parallels=2,
+                       model_dir="unused", learning_rate_actor=1e-3, learning_rate_critic=1e-3,
+                       gamma=.99, tau=.1, end_factor_lr_decay=1., actor_update_delay=2,
+                       target_policy_noise=.2, target_noise_clip=.5, td3_actor_use_first_critic=True)
+    return MATD3_Learner(config, [KEYS[0]], KEYS, p, MultiAgentBaseCallback())
+
+
+def sample():
+    obs = observations().reshape(3, 4, -1).numpy()
+    return {"batch_size": 3, "obs": {k: obs[:, i] for i, k in enumerate(KEYS)},
+            "obs_next": {k: obs[:, i] * .9 for i, k in enumerate(KEYS)},
+            "actions": {k: np.ones((3, 3), np.float32) * .1 for k in KEYS},
+            "rewards": {k: np.ones(3, np.float32) for k in KEYS},
+            "terminals": {k: np.zeros(3, np.float32) for k in KEYS},
+            "agent_mask": {k: np.ones(3, np.float32) for k in KEYS}}
+
+
+@pytest.mark.parametrize("critic_hgat", [True, False])
+def test_critics_are_independent_and_freshly_initialized(critic_hgat):
+    p = policy(critic_hgat)
+    groups = [list(p.actor_representation.parameters()) + list(p.actor.parameters()),
+              list(p.critic_A_representation.parameters()) + list(p.critic_A.parameters()),
+              list(p.critic_B_representation.parameters()) + list(p.critic_B.parameters())]
+    for i, group in enumerate(groups):
+        assert len(set(map(id, group))) == len(group)
+        assert all(not set(map(id, group)) & set(map(id, other)) for other in groups[i + 1:])
+    assert set(map(id, p.parameters_critic[KEYS[0]])) == set(map(id, groups[1] + groups[2]))
+    assert not torch.equal(p.critic_A[KEYS[0]].model[0].weight, p.critic_B[KEYS[0]].model[0].weight)
+    if critic_hgat:
+        assert not torch.equal(p.critic_A_representation[KEYS[0]].layer1.projection.weight,
+                               p.critic_B_representation[KEYS[0]].layer1.projection.weight)
+    assert not any(name.startswith("critic.") for name in p.state_dict())
+    assert all(not value.requires_grad for name, value in p.named_parameters() if name.startswith("target_"))
+
+
+def test_target_uses_elementwise_minimum_and_online_api_keeps_mean():
+    p = policy()
+    with torch.no_grad():
+        for module, constant in ((p.critic_A, 3.), (p.critic_B, 7.),
+                                  (p.target_critic_A, 5.), (p.target_critic_B, 2.)):
+            for parameter in module.parameters():
+                parameter.zero_()
+            module[KEYS[0]].model[-1].bias.fill_(constant)
+    obs = observations()
+    actions = torch.zeros(3, 12)
+    q_a, q_b, q_mean = p.Qpolicy(obs.reshape(3, -1), actions, ids())
+    assert (q_a[KEYS[0]] == 3).all() and (q_b[KEYS[0]] == 7).all()
+    assert (q_mean[KEYS[0]] == 5).all()
+    assert (p.Qtarget(obs.reshape(3, -1), actions, ids())[KEYS[0]] == 2).all()
+
+
+@pytest.mark.parametrize("critic_hgat", [True, False])
+def test_real_delayed_updates_and_all_six_target_modules(critic_hgat):
+    p = policy(critic_hgat)
+    learn = learner(p)
