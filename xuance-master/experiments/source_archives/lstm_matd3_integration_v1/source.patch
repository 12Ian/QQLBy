@@ -0,0 +1,244 @@
+"""HGAT-DRL style graph representation adapted to UAV MADDPG (not TD3).
+
+Only the existing local observation is used by the actor. The critic encodes
+all local views with its own weights and retains all joint actions.
+"""
+from copy import deepcopy
+from dataclasses import asdict, dataclass
+
+import torch
+from torch import nn
+from .core import ActorNet, CriticNet
+
+
+@dataclass(frozen=True)
+class UAVGraphLayout:
+    n_agents: int = 4
+    building_k: int = 5
+    context_dim: int = 4
+    prediction_steps: int = 0
+
+    def __post_init__(self):
+        if self.n_agents < 1 or self.building_k < 0 or self.prediction_steps < 0:
+            raise ValueError("Invalid UAV graph node counts")
+        if self.context_dim not in (0, 4):
+            raise ValueError("UAV curriculum context must contain zero or four features")
+
+    @property
+    def mate_end(self):
+        return 11 + 6 * (self.n_agents - 1)
+
+    @property
+    def target_start(self):
+        return self.mate_end + 6
+
+    @property
+    def context_start(self):
+        return self.target_start + 10
+
+    @property
+    def building_start(self):
+        return self.context_start + self.context_dim + 3 * self.prediction_steps
+
+    @property
+    def obs_dim(self):
+        return self.building_start + 6 * self.building_k
+
+    @property
+    def ego_dim(self):
+        return 17 + self.context_dim
+
+    @property
+    def target_dim(self):
+        return 10 + 3 * self.prediction_steps
+
+    @property
+    def feature_dim(self):
+        return self.ego_dim + 6 + self.target_dim + 5
+
+    @property
+    def node_count(self):
+        return self.n_agents + 1 + self.building_k
+
+    def build(self, obs):
+        if obs.shape[-1] != self.obs_dim:
+            raise ValueError(f"UAV HGAT observation layout expects {self.obs_dim}, got {obs.shape[-1]}")
+        ego = torch.cat((obs[..., :11], obs[..., self.mate_end:self.target_start],
+                         obs[..., self.context_start:self.context_start + self.context_dim]), dim=-1)
+        target = torch.cat((obs[..., self.target_start:self.context_start],
+                            obs[..., self.context_start + self.context_dim:self.building_start]), dim=-1)
+        nodes = obs.new_zeros(*obs.shape[:-1], self.node_count, self.feature_dim)
+        e, m, t = self.ego_dim, self.ego_dim + 6, self.ego_dim + 6 + self.target_dim
+        nodes[..., 0, :e] = ego
+        nodes[..., 1:self.n_agents, e:m] = obs[..., 11:self.mate_end].reshape(
+            *obs.shape[:-1], self.n_agents - 1, 6)
+        nodes[..., self.n_agents, m:t] = target
+        buildings = obs[..., self.building_start:].reshape(*obs.shape[:-1], self.building_k, 6)
+        valid = torch.ones(*obs.shape[:-1], self.node_count, dtype=torch.bool, device=obs.device)
+        valid[..., self.n_agents + 1:] = buildings[..., 5] > 0.5
+        nodes[..., self.n_agents + 1:, t:] = torch.where(
+            valid[..., self.n_agents + 1:, None], buildings[..., :5], 0.0)
+
+        # Convention: adjacency[receiver, sender]. Static objects never react.
+        moving = self.n_agents + 1
+        edges = torch.eye(self.node_count, dtype=torch.bool, device=obs.device)
+        edges[:moving, :] = True
+        edges = edges & valid.unsqueeze(-1) & valid.unsqueeze(-2)
+        return nodes, valid, edges, ego
+
+
+class DirectedGATLayer(nn.Module):
+    """Single-head additive attention; excluded senders are masked before softmax."""
+    def __init__(self, input_dim, hidden_dim):
+        super().__init__()
+        self.projection = nn.Linear(input_dim, hidden_dim, bias=False)
+        self.receiver_score = nn.Linear(hidden_dim, 1, bias=False)
+        self.sender_score = nn.Linear(hidden_dim, 1, bias=False)
+        self.activation = nn.LeakyReLU(0.2)
+        for module in (self.projection, self.receiver_score, self.sender_score):
+            nn.init.xavier_uniform_(module.weight)
+
+    def forward(self, nodes, edges):
+        h = self.projection(nodes)
+        scores = self.activation(self.receiver_score(h) + self.sender_score(h).transpose(-1, -2))
+        scores = scores.masked_fill(~edges, torch.finfo(scores.dtype).min)
+        weights = torch.softmax(scores, dim=-1) * edges.to(scores.dtype)
+        # Also handles an entirely empty row/graph without NaNs or bias messages.
+        weights = weights / weights.sum(dim=-1, keepdim=True).clamp_min(1e-12)
+        return self.activation(weights @ h), weights
+
+
+class UAVHeteroGATEncoder(nn.Module):
+    def __init__(self, layout, hidden_dim=32):
+        super().__init__()
+        self.layout = layout
+        self.layer1 = DirectedGATLayer(layout.feature_dim, hidden_dim)
+        self.layer2 = DirectedGATLayer(hidden_dim, hidden_dim)
+        self.output_shapes = {"state": (layout.ego_dim + hidden_dim,)}
+
+    def forward(self, obs, return_attention=False):
+        nodes, valid, edges, ego = self.layout.build(obs)
+        h1, a1 = self.layer1(nodes, edges)
+        h2, a2 = self.layer2(h1, edges)
+        encoded = torch.cat((ego, h1[..., 0, :] + h2[..., 0, :]), dim=-1)
+        if return_attention:
+            return encoded, {"layer1": a1, "layer2": a2, "valid": valid, "edges": edges}
+        return {"state": encoded}
+
+
+class UAV_HGAT_MADDPG_Policy(nn.Module):
+    """Shared-parameter, feed-forward MADDPG with independent A/C graph weights."""
+    def __init__(self, action_space, layout, actor_hidden_size, critic_hidden_size,
+                 model_keys, hidden_dim=32, critic_hgat=True, normalize=None,
+                 initialize=None, activation=nn.LeakyReLU, activation_action=nn.Tanh,
+                 device="cpu"):
+        super().__init__()
+        self.device = device
+        self.layout = layout
+        self.n_agents = layout.n_agents
+        self.action_space = action_space
+        self.model_keys = list(model_keys)
+        if len(self.model_keys) != 1 or len(action_space) != self.n_agents:
+            raise ValueError("UAV HGAT currently requires homogeneous shared-parameter agents")
+        action_dims = {space.shape[-1] for space in action_space.values()}
+        if action_dims != {3}:
+            raise ValueError("UAV HGAT requires three-dimensional acceleration actions")
+        self.use_parameter_sharing, self.use_rnn = True, False
+        self.critic_hgat = bool(critic_hgat)
+        self.hidden_dim = int(hidden_dim)
+        if self.hidden_dim < 1:
+            raise ValueError("HGAT hidden dimension must be positive")
+        key = self.model_keys[0]
+        self.actor_representation = nn.ModuleDict({key: UAVHeteroGATEncoder(layout, hidden_dim)})
+        self.critic_representation = nn.ModuleDict({key: UAVHeteroGATEncoder(layout, hidden_dim)
+                                                   if critic_hgat else nn.Identity()})
+        encoded_dim = layout.ego_dim + hidden_dim
+        critic_dim = (encoded_dim if critic_hgat else layout.obs_dim) * self.n_agents
+        self.actor = nn.ModuleDict({key: ActorNet(encoded_dim + self.n_agents, 3, actor_hidden_size,
+                                                normalize, initialize, activation, activation_action, device)})
+        self.critic = nn.ModuleDict({key: CriticNet(critic_dim + 3 * self.n_agents + self.n_agents,
+                                                  critic_hidden_size, normalize, initialize, activation, device)})
+        self.target_actor_representation = deepcopy(self.actor_representation).requires_grad_(False)
+        self.target_critic_representation = deepcopy(self.critic_representation).requires_grad_(False)
+        self.target_actor = deepcopy(self.actor).requires_grad_(False)
+        self.target_critic = deepcopy(self.critic).requires_grad_(False)
+        self.to(device)
+
+    def get_extra_state(self):
+        return {"version": 1, "layout": asdict(self.layout), "hidden_dim": self.hidden_dim,
+                "critic_hgat": self.critic_hgat, "model_keys": self.model_keys}
+
+    def set_extra_state(self, state):
+        if state != self.get_extra_state():
+            raise ValueError("UAV HGAT checkpoint architecture/observation layout mismatch")
+
+    def load_state_dict(self, state_dict, strict=True):
+        # The general Xuance loader uses strict=False. This architecture must not
+        # silently accept an old flat/GAT-O checkpoint or incomplete target graph.
+        if state_dict.get("_extra_state") != self.get_extra_state():
+            raise ValueError("UAV HGAT checkpoint architecture/observation layout mismatch")
+        return super().load_state_dict(state_dict, strict=True)
+
+    @property
+    def parameters_actor(self):
+        return {k: list(self.actor_representation[k].parameters()) + list(self.actor[k].parameters())
+                for k in self.model_keys}
+
+    @property
+    def parameters_critic(self):
+        return {k: list(self.critic_representation[k].parameters()) + list(self.critic[k].parameters())
+                for k in self.model_keys}
+
+    def _tensor(self, value):
+        return torch.as_tensor(value, dtype=torch.float32, device=next(self.parameters()).device)
+
+    def _actions(self, observations, agent_ids, target, agent_key=None):
+        representations = self.target_actor_representation if target else self.actor_representation
+        heads = self.target_actor if target else self.actor
+        ids = self._tensor(agent_ids)
+        actions = {}
+        for key in ([agent_key] if agent_key else self.model_keys):
+            state = representations[key](self._tensor(observations[key]))["state"]
+            actions[key] = heads[key](torch.cat((state, ids), dim=-1))
+        return {}, actions
+
+    def forward(self, observation, agent_ids, agent_key=None, rnn_hidden=None):
+        return self._actions(observation, agent_ids, False, agent_key)
+
+    def Atarget(self, next_observation, agent_ids, agent_key=None, rnn_hidden=None):
+        return self._actions(next_observation, agent_ids, True, agent_key)
+
+    def _values(self, joint_observation, joint_actions, agent_ids, target, agent_key=None):
+        observations, actions = self._tensor(joint_observation), self._tensor(joint_actions)
+        if observations.ndim != 2 or observations.shape[-1] != self.n_agents * self.layout.obs_dim:
+            raise ValueError("UAV HGAT critic requires batched joint observations in agent order")
+        if actions.shape != (observations.shape[0], 3 * self.n_agents):
+            raise ValueError("UAV HGAT critic requires all joint acceleration actions")
+        batch = observations.shape[0]
+        representations = self.target_critic_representation if target else self.critic_representation
+        heads = self.target_critic if target else self.critic
+        values = {}
+        for key in ([agent_key] if agent_key else self.model_keys):
+            if self.critic_hgat:
+                state = representations[key](observations.reshape(batch * self.n_agents, self.layout.obs_dim))[
+                    "state"].reshape(batch, -1)
+            else:
+                state = observations
+            joint = torch.cat((state, actions), dim=-1)
+            joint = joint.unsqueeze(1).expand(-1, self.n_agents, -1).reshape(batch * self.n_agents, -1)
+            values[key] = heads[key](torch.cat((joint, self._tensor(agent_ids)), dim=-1))
+        return {}, values
+
+    def Qpolicy(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        return self._values(joint_observation, joint_actions, agent_ids, False, agent_key)
+
+    def Qtarget(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        return self._values(joint_observation, joint_actions, agent_ids, True, agent_key)
+
+    @torch.no_grad()
+    def soft_update(self, tau=0.005):
+        for source, target in ((self.actor_representation, self.target_actor_representation),
+                               (self.critic_representation, self.target_critic_representation),
+                               (self.actor, self.target_actor), (self.critic, self.target_critic)):
+            for parameter, target_parameter in zip(source.parameters(), target.parameters()):
+                target_parameter.lerp_(parameter, tau)
