+        assert not h.ready
+    obs,ctx=fake_frame(4.7);h.append(obs,ctx,AGENTS)
+    assert not h.ready
+    assert np.isfinite(net.predict([h])[0]).all()
+    with pytest.raises(ValueError,match="did not advance"):h.append(obs,ctx,AGENTS)
