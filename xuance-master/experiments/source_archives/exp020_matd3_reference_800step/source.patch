+"""Regression checks for the next experiment's evader building avoidance."""
+import numpy as np
+
+from xuance.environment.multi_agent_env.uav_pursuit_coverage_3d import UAVPursuitCoverage3DEnv
+
+
+def evader_scene(dynamic=True):
+    env = object.__new__(UAVPursuitCoverage3DEnv)
+    env.map_size, env.z_min, env.z_max = 1000., 50., 350.
+    env.target_radius = .5
+    env.target_position = np.array([430., 500., 200.], np.float32)
+    env.target_velocity = np.array([12., 0., 0.], np.float32)
+    env.target_acceleration = np.zeros(3, np.float32)
+    env.target_speed = env.episode_target_speed_max = 12.
+    env.target_min_speed, env.target_max_speed = 3., 12.
+    env.target_accel, env.target_jerk_max = 4., 8.
+    env.acceleration_lag, env.target_velocity_response = .5, 1.
+    env.evader_sense, env.evader_rep_coef = 200., 40.
+    env.evader_obstacle_range, env.evader_obstacle_coef = 20., 40.
+    env.evader_boundary_range, env.evader_boundary_coef = 100., 50.
+    env.evader_center_pull = 0.
+    env.evader_center_xy_range, env.evader_center_z_range = 150., 75.
+    env.evader_blend_center = True
+    env.evader_dynamic_avoidance = dynamic
+    env.evader_avoid_reaction_time, env.evader_avoid_margin = 1.5, 10.
+    env._evader_avoid_building, env._evader_avoid_side = None, 1.
+    env.buildings = np.array([[500., 550., 400., 600., 300.]], np.float32)
+    env.uav_positions = np.array([[300., 500., 200.]], np.float32)
+    env.rng = np.random.RandomState(1)
+    env.episode_target_wall_contacts = 0
+    env.episode_target_building_contacts = 0
+    return env
+
+
+def test_warning_distance_grows_with_speed():
+    env = evader_scene()
+    assert env._evader_warning_distance(3.) == 20.
+    assert abs(env._evader_warning_distance(12.) - 64.) < 1e-6
+
+
+def test_head_on_fast_evader_avoids_building_without_contact():
+    env = evader_scene()
+    minimum_clearance = float("inf")
+    for _ in range(200):
+        command = env._evader_control()
+        env._advance_evader_substep(command, .1)
+        minimum_clearance = min(minimum_clearance,
+                                float(np.min(env._building_distances_3d(env.target_position))))
+    assert env.episode_target_building_contacts == 0
+    assert minimum_clearance > env.target_radius + 2.
+
+
+def test_all_curriculum_speeds_clear_a_head_on_building():
+    for speed in (3., 5., 8., 10., 12.):
+        env = evader_scene()
+        env.target_min_speed = env.target_max_speed = speed
+        env.target_velocity[:] = [speed, 0., 0.]
+        env.target_position[0] = 500. - env._evader_warning_distance(speed) - 5.
+        env.uav_positions[:] = env.target_position - [80., 0., 0.]
+        minimum_clearance = float("inf")
+        for _ in range(250):
+            env._advance_evader_substep(env._evader_control(), .1)
+            minimum_clearance = min(minimum_clearance,
+                                    float(np.min(env._building_distances_3d(env.target_position))))
+        assert env.episode_target_building_contacts == 0, speed
+        assert minimum_clearance > env.target_radius + 2., speed
+
+
+def test_avoidance_side_remains_stable_and_forecast_does_not_change_it():
+    env = evader_scene()
+    env.target_position[0] = 445.
+    env._evader_control()
+    selected = (env._evader_avoid_building, env._evader_avoid_side)
+    assert selected[0] == 0
+    env._evader_control(position=np.array([450., 500., 200.], np.float32),
+                        deterministic=True)
+    assert (env._evader_avoid_building, env._evader_avoid_side) == selected
+    for x in (450., 455., 460.):
+        env.target_position[0] = x
+        env._evader_control()
+        assert (env._evader_avoid_building, env._evader_avoid_side) == selected
+
+
+def test_head_on_route_chooses_the_open_side():
+    env = evader_scene()
+    env.target_position[0] = 445.
+    env.buildings = np.vstack((env.buildings,
+                               np.array([[420., 470., 390., 430., 300.]], np.float32)))
+    env._evader_control()
+    assert env._evader_avoid_building == 0
+    assert env._evader_avoid_side == -1.
+
+
+def test_target_building_contact_is_reported_separately():
+    env = evader_scene(dynamic=False)
+    env.target_position[0] = 499.
+    env.target_velocity[:] = [12., 0., 0.]
+    env._advance_evader_substep(np.zeros(3), .1)
+    assert env.episode_target_building_contacts == 1
+    assert env.episode_target_wall_contacts == 0
