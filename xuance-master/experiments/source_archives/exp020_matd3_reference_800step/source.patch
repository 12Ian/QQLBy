+"""Freeze current settings, then run MATD3 and MATD3-HGAT serially, fail-fast."""
+import argparse
+from copy import deepcopy
+import csv
+from datetime import datetime, timezone
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import signal
+import subprocess
+import sys
+import time
+import traceback
+
+import yaml
+
+
+METHODS = (("matd3", "exp020_matd3", "MATD3_Policy"),
+           ("matd3_hgat", "exp021_matd3_hgat", "UAV_HGAT_MATD3_Policy"))
+
+
+def now():
+    return datetime.now(timezone.utc).isoformat()
+
+
+def digest(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def write_json(path, value):
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")
+    temporary.replace(path)
+
+
+def build_configs(common, steps=6000000, parallels=16, seed=1, smoke=False):
+    common = deepcopy(common)
+    common.update(running_steps=steps, parallels=parallels, seed=seed, env_seed=seed,
+                  baseline_init_actor=None, baseline_init_checkpoint=None,
+                  uav_collision_enabled=False, terminate_on_collision=False,
+                  terminate_on_building_collision=True, terminate_on_boundary_collision=True,
+                  baseline_evaluate_full_episode=False, curriculum_eval_all_levels=True,
+                  curriculum_start_level=0, baseline_save_initial_model=True)
+    if smoke:
+        common.update(running_steps=128, parallels=2, episode_length=32, actor_hidden_size=[64, 64],
+                      critic_hidden_size=[64, 64], batch_size=32, buffer_size=256, start_training=32,
+                      eval_interval=64, test_episode=2, baseline_eval_parallels=2,
+                      baseline_final_eval_interval=64, baseline_retention_eval_interval=64)
+    if common["running_steps"] <= common["start_training"] or common["running_steps"] % common["parallels"]:
+        raise ValueError("Budget must exceed replay warmup and be divisible by parallels")
+    if [float(stage["target_max_speed"]) for stage in common["curriculum_schedule"]] != [3., 5., 8., 10., 12.]:
+        raise ValueError("The current baseline requires target speeds 3/5/8/10/12")
+    for flag in ("safety_filter_enabled", "evader_dynamic_avoidance", "matd3_clip_actions"):
+        if not common.get(flag):
+            raise ValueError(f"Current baseline setting must remain enabled: {flag}")
+    configs = {}
+    for label, name, policy in METHODS:
+        configs[label] = dict(common, policy=policy, env_id="baseline_" + name)
+    validate_pair(configs)
+    return configs
+
+
+def validate_pair(configs):
+    a, b = (configs[label] for label, _, _ in METHODS)
+    differences = {key for key in set(a) | set(b) if a.get(key) != b.get(key)}
+    if differences != {"policy", "env_id"}:
+        raise ValueError(f"Unexpected comparison differences: {differences}")
+    for config in (a, b):
+        if config["baseline_evaluate_full_episode"] or config["uav_collision_enabled"]:
+            raise ValueError("User selected collision termination without inter-UAV collision accounting")
+        if config["baseline_init_actor"] or config["baseline_init_checkpoint"]:
+            raise ValueError("Both methods must start from random weights")
+
+
+def process_identity(pid):
+    path = Path(f"/proc/{pid}/cmdline")
+    try:
+        data = path.read_bytes()
+        return hashlib.sha256(data).hexdigest() if data else None
+    except FileNotFoundError:
+        return None
+
+
+def prepare(args):
+    source, run = args.source_root.resolve(), args.run_dir.resolve()
+    if not (source / "xuance/__init__.py").is_file():
+        raise ValueError("--source-root must be a complete repository, not a partial local mirror")
+    common_path = args.base_config or source / "experiments/matd3_current_environment.yaml"
+    configs = build_configs(yaml.safe_load(common_path.read_text(encoding="utf-8")),
+                            args.steps, args.parallels, args.seed, args.smoke)
+    run.mkdir(parents=True, exist_ok=False)
+    for folder in ("xuance", "examples", "experiments", "tools", "tests"):
+        if (source / folder).is_dir():
+            shutil.copytree(source / folder, run / "code" / folder,
+                            ignore=shutil.ignore_patterns("__pycache__", "*.pyc", ".pytest_cache"))
+    (run / "configs").mkdir()
+    for label, config in configs.items():
+        (run / "configs" / (label + ".yaml")).write_text(yaml.safe_dump(config, sort_keys=False), encoding="utf-8")
+    manifest = {str(path.relative_to(run)).replace(os.sep, "/"): digest(path)
+                for folder in (run / "code", run / "configs") for path in folder.rglob("*") if path.is_file()}
+    write_json(run / "source_manifest.json", manifest)
+    waits = [{"pid": pid, "identity": identity} for pid in args.wait_for_pid
+             if (identity := process_identity(pid)) is not None]
+    protocol = dict(created_at_utc=now(), smoke=args.smoke, methods=[m[0] for m in METHODS],
+                    training_steps_per_method=configs["matd3"]["running_steps"],
+                    training_seed=args.seed, seed_base=args.eval_seed_base,
+                    episodes_per_level=configs["matd3"]["test_episode"],
+                    eval_workers=2 if args.smoke else args.eval_workers, eval_inference_device="cpu",
+                    device=args.device, min_free_gib=args.min_free_gib, wait_for_processes=waits,
+                    source_manifest_sha256=digest(run / "source_manifest.json"),
+                    collision_protocol="building/boundary terminate; inter-UAV ignored",
+                    initialization="random for both methods; separate optimizers and replay")
+    write_json(run / "protocol.json", protocol)
+    for relative in manifest:
+        (run / relative).chmod(0o444)
+    (run / "protocol.json").chmod(0o444)
+    (run / "source_manifest.json").chmod(0o444)
+    write_json(run / "prepared.json", dict(status="prepared", source_root=str(source), run_dir=str(run)))
+    print(json.dumps(dict(prepared=str(run), execute=[sys.executable,
+          str(run / "code/tools/run_matd3_hgat_comparison.py"), "--execute", "--run-dir", str(run)])), flush=True)
+
+
+def verify_sources(run, protocol):
+    if digest(run / "source_manifest.json") != protocol["source_manifest_sha256"]:
+        raise ValueError("Source manifest changed")
+    expected = json.loads((run / "source_manifest.json").read_text())
+    for name, sha in expected.items():
+        if digest(run / name) != sha:
+            raise ValueError(f"Frozen source changed: {name}")
+
+
+def stop_child(process):
+    if process.poll() is not None:
+        return
+    if os.name == "posix":
+        os.killpg(process.pid, signal.SIGTERM)
+    else:
+        process.terminate()
+    try:
+        process.wait(timeout=20)
+    except subprocess.TimeoutExpired:
+        if os.name == "posix":
+            os.killpg(process.pid, signal.SIGKILL)
+        else:
+            process.kill()
+        process.wait()
+
+
+def check_space(run, protocol):
+    free = shutil.disk_usage(run).free
+    if free < protocol["min_free_gib"] * 1024 ** 3:
+        raise RuntimeError(f"Disk guard: {free / 1024**3:.2f} GiB free; preserving evidence and stopping")
+    return free
+
+
+def training_audit(run, label, name, cfg):
+    import torch
+    result = run / "code/outputs/results/matd3" / ("baseline_" + name)
+    summary = json.loads((result / "baseline_summary.json").read_text())
+    if summary["environment_steps"] != cfg["running_steps"]:
+        raise ValueError("Training did not reach its full budget")
+    final_eval = summary["final_all_levels"]
+    if len(final_eval) != 5 or {r["level"] for r in final_eval} != set(range(5)):
+        raise ValueError("Final curriculum evaluation is incomplete")
+    if any(r["episodes"] != cfg["test_episode"] for r in final_eval):
+        raise ValueError("Incorrect evaluation episode count")
+    runtime = json.loads((result / "config.json").read_text())
+    for key in ("policy", "curriculum_schedule", "uav_collision_enabled", "terminate_on_building_collision",
+                "terminate_on_boundary_collision", "baseline_evaluate_full_episode", "safety_filter_enabled",
+                "evader_dynamic_avoidance", "baseline_init_actor", "baseline_init_checkpoint"):
+        if runtime.get(key) != cfg[key]:
+            raise ValueError(f"Runtime configuration mismatch: {key}")
+    model_dir = run / "code/outputs/models/matd3" / ("baseline_" + name)
+    models = list(model_dir.rglob("final_train_model.pth"))
+    if len(models) != 1:
+        raise ValueError("Expected exactly one final checkpoint")
+    model = models[0]
+    final = torch.load(model, map_location="cpu", weights_only=True)
+    initial = torch.load(model.parent / "initial_random_model.pth", map_location="cpu", weights_only=True)
+    state = final["policy"]
+    if not all(torch.isfinite(value).all() for value in state.values() if torch.is_tensor(value)):
+        raise ValueError("Non-finite final model")
+    updates = (cfg["running_steps"] - cfg["start_training"]) // cfg["parallels"]
+    with (result / "training_updates.csv").open() as stream:
+        rows = list(csv.DictReader(stream))
+    if not rows or any(not math.isfinite(float(value)) for row in rows for value in row.values() if value):
+        raise ValueError("Missing or non-finite training update history")
+    if int(rows[-1]["updates"]) != updates or int(rows[-1]["actor_updates"]) != updates // cfg["actor_update_delay"]:
+        raise ValueError("Unexpected Critic/Actor update counts")
+    for group, count in (("actor", updates // cfg["actor_update_delay"]), ("critic", updates)):
+        for key in final["optimizer"]:
+            states = final["optimizer"][key][group]["state"]
+            if not states or any(int(value["step"].item()) != count for value in states.values()):
+                raise ValueError(f"Checkpoint Adam counter mismatch: {group}")
+            if initial["optimizer"][key][group]["state"]:
+                raise ValueError("Initial optimizer was not fresh")
+    prefixes = ["actor.", "critic_A.", "critic_B."]
+    if label == "matd3_hgat":
+        prefixes += ["actor_representation.", "critic_A_representation.", "critic_B_representation.",
+                     "target_actor_representation.", "target_critic_A_representation.", "target_critic_B_representation."]
+    changed = {prefix: sum(not torch.equal(value, initial["policy"][key])
+                          for key, value in state.items() if key.startswith(prefix)) for prefix in prefixes}
+    if not all(changed.values()):
+        raise ValueError("An expected network branch did not change")
+    return dict(environment_steps=summary["environment_steps"], critic_updates=updates,
+                actor_updates=updates // cfg["actor_update_delay"], checkpoint=str(model),
+                checkpoint_sha256=digest(model), changed_tensors=changed,
+                training_elapsed_seconds=summary["elapsed_seconds"], curriculum_level=summary["curriculum_level"])
+
+
+def write_comparison(run, audits):
+    rows = []
+    for level in range(5):
+        reports = {label: json.loads((run / label / f"level_{level}.json").read_text())
+                   for label, _, _ in METHODS}
+        left, right = (reports[label]["episodes"] for label, _, _ in METHODS)
+        if [(r["env_seed"], r["initial_sha256"]) for r in left] != [(r["env_seed"], r["initial_sha256"]) for r in right]:
+            raise ValueError("Methods were not evaluated on the same initial cases")
+        row = dict(level=level + 1, target_max_speed=[3, 5, 8, 10, 12][level], initial_cases_match=True)
+        for label, report in reports.items():
+            for key in ("success_rate", "safe_success_rate", "collision_rate", "mean_episode_steps"):
+                row[label + "_" + key] = report["metrics"][key]
+            row[label + "_intervention_fraction"] = report["safety_metrics"]["intervention_fraction"]
+        rows.append(row)
+    protocol = json.loads((run / "protocol.json").read_text())
+    write_json(run / "comparison.json", dict(audits=audits, levels=rows, training_seeds=[protocol["training_seed"]],
+                                              limitation="One training seed, fixed cities, no unseen-map claim"))
+    with (run / "comparison.csv").open("x", newline="", encoding="utf-8") as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))
+        writer.writeheader()
+        writer.writerows(rows)
+
+
+def execute(args):
+    run = args.run_dir.resolve()
+    protocol = json.loads((run / "protocol.json").read_text())
+    if not Path(__file__).resolve().is_relative_to(run / "code"):
+        raise ValueError("Execute the frozen script inside RUN_DIR/code/tools")
+    with (run / "execute.lock").open("x") as stream:
+        stream.write(str(os.getpid()))
+    state = dict(status="running", phase="preflight", pid=os.getpid(), started_at_utc=now(), stages=[])
+    path = run / "process.json"
+    env = dict(os.environ, PYTHONPATH=str(run / "code"), PYTHONUNBUFFERED="1", OMP_NUM_THREADS="1",
+               OPENBLAS_NUM_THREADS="1", MKL_NUM_THREADS="1", TQDM_MININTERVAL="30")
+    configs = {label: yaml.safe_load((run / "configs" / (label + ".yaml")).read_text()) for label, _, _ in METHODS}
+    write_json(path, state)
+
+    def run_stage(stage, command):
+        verify_sources(run, protocol)
+        state.update(status="running", phase=stage, phase_started_at_utc=now(),
+                     free_disk_bytes=check_space(run, protocol), command=command)
+        write_json(path, state)
+        print(f"[{now()}] start {stage}", flush=True)
+        with (run / (stage + ".log")).open("x", encoding="utf-8") as stream:
+            process = subprocess.Popen(command, cwd=run / "code", env=env, stdout=stream,
+                                       stderr=subprocess.STDOUT, start_new_session=os.name == "posix")
+            state["child_pid"] = process.pid
+            write_json(path, state)
+            try:
+                checked = 0.0
+                while process.poll() is None:
+                    if time.monotonic() - checked >= 15:
+                        state.update(last_health_at_utc=now(), free_disk_bytes=check_space(run, protocol))
+                        verify_sources(run, protocol)
+                        write_json(path, state)
+                        checked = time.monotonic()
+                    time.sleep(1)
+                if process.returncode:
+                    raise RuntimeError(f"{stage} exited {process.returncode}; see {stage}.log")
+            except BaseException:
+                stop_child(process)
+                raise
+        state.pop("child_pid", None)
+        state["stages"].append(dict(stage=stage, returncode=0, completed_at_utc=now()))
+        write_json(path, state)
+
+    try:
+        validate_pair(configs)
+        verify_sources(run, protocol)
+        while True:
+            pending = [r["pid"] for r in protocol["wait_for_processes"] if process_identity(r["pid"]) == r["identity"]]
+            if not pending:
+                break
+            state.update(status="waiting", phase="waiting_for_previous_job", waiting_pids=pending,
+                         free_disk_bytes=check_space(run, protocol), last_health_at_utc=now())
+            write_json(path, state)
+            time.sleep(15)
+        state.pop("waiting_pids", None)
+        audits = {}
+        for label, name, _ in METHODS:
+            config = configs[label]
+            config_path = run / "configs" / (label + ".yaml")
+            run_stage(label + "_train", [sys.executable, "-u", str(run / "code/examples/run_baseline.py"),
+                      "--config", str(config_path), "--name", name, "--steps", str(config["running_steps"]),
+                      "--parallels", str(config["parallels"]), "--seed", str(config["seed"]),
+                      "--device", protocol["device"], "--start-level", "0", "--eval-interval", str(config["eval_interval"]),
+                      "--test-episodes", str(config["test_episode"])])
+            audits[label] = training_audit(run, label, name, config)
+            (run / label).mkdir()
+            write_json(run / label / "training_audit.json", audits[label])
+            for level in range(5):
+                run_stage(label + f"_eval_level_{level}", [sys.executable, "-u",
+                          str(run / "code/tools/evaluate_matd3_fixed_cases.py"), "--config", str(config_path),
+                          "--checkpoint", audits[label]["checkpoint"], "--level", str(level),
+                          "--seed-base", str(protocol["seed_base"]), "--episodes", str(protocol["episodes_per_level"]),
+                          "--workers", str(protocol["eval_workers"]), "--output", str(run / label / f"level_{level}.json")])
+        write_comparison(run, audits)
+        verify_sources(run, protocol)
+        state.update(status="completed", phase="both_methods_verified", completed_at_utc=now())
+    except BaseException:
+        state.update(status="failed", error=traceback.format_exc(), failed_at_utc=now())
+        print(state["error"], flush=True)
+    finally:
+        write_json(path, state)
+    return 0 if state["status"] == "completed" else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument("--prepare-only", action="store_true")
+    mode.add_argument("--execute", action="store_true")
+    mode.add_argument("--status", action="store_true")
+    parser.add_argument("--run-dir", type=Path, required=True)
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument("--base-config", type=Path)
+    parser.add_argument("--steps", type=int, default=6000000)
+    parser.add_argument("--parallels", type=int, default=16)
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--device", default="cuda:0")
+    parser.add_argument("--eval-seed-base", type=int, default=145001)
+    parser.add_argument("--eval-workers", type=int, default=8)
+    parser.add_argument("--min-free-gib", type=float, default=2.0)
+    parser.add_argument("--wait-for-pid", type=int, action="append", default=[])
+    parser.add_argument("--smoke", action="store_true", help="128 steps/method; a separate complete pipeline check")
+    args = parser.parse_args()
+    if min(args.steps, args.parallels, args.eval_workers) < 1 or not math.isfinite(args.min_free_gib) or args.min_free_gib < 0:
+        parser.error("Invalid budget or resource setting")
+    if args.prepare_only:
+        prepare(args)
+        return 0
+    if args.status:
+        print((args.run_dir / "process.json").read_text())
+        return 0
+    def interrupt(signum, frame):
+        raise KeyboardInterrupt(f"Signal {signum}")
+    signal.signal(signal.SIGTERM, interrupt)
+    return execute(args)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
