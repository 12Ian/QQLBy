+"""UAV HGAT actor and two independent graph critics for the MATD3 learner."""
+from copy import deepcopy
+
+import torch
+from torch import nn
+from .core import CriticNet
+from .uav_hgat_maddpg import UAVHeteroGATEncoder, UAV_HGAT_MADDPG_Policy
+
+
+class UAV_HGAT_MATD3_Policy(UAV_HGAT_MADDPG_Policy):
+    """Reuse local graph/actor semantics; expose MATD3's twin-Q policy API."""
+    def __init__(self, action_space, layout, actor_hidden_size, critic_hidden_size,
+                 model_keys, hidden_dim=32, critic_hgat=True, normalize=None,
+                 initialize=None, activation=nn.LeakyReLU, activation_action=nn.Tanh,
+                 device="cpu"):
+        super().__init__(action_space, layout, actor_hidden_size, critic_hidden_size,
+                         model_keys, hidden_dim, critic_hgat, normalize, initialize,
+                         activation, activation_action, device)
+        # Rename the existing first critic, without registering parameter aliases.
+        for name in ("critic_representation", "critic", "target_critic_representation", "target_critic"):
+            replacement = name.replace("critic", "critic_A", 1)
+            setattr(self, replacement, getattr(self, name))
+            delattr(self, name)
+        key = self.model_keys[0]
+        # Fresh initialization is essential: copying A could keep the two critics
+        # identical under the same deterministic targets and training batches.
+        self.critic_B_representation = nn.ModuleDict({key: UAVHeteroGATEncoder(layout, hidden_dim)
+                                                     if critic_hgat else nn.Identity()})
+        state_dim = layout.ego_dim + hidden_dim if critic_hgat else layout.obs_dim
+        self.critic_B = nn.ModuleDict({key: CriticNet(
+            state_dim * self.n_agents + 3 * self.n_agents + self.n_agents,
+            critic_hidden_size, normalize, initialize, activation, device)})
+        self.target_critic_B_representation = deepcopy(self.critic_B_representation).requires_grad_(False)
+        self.target_critic_B = deepcopy(self.critic_B).requires_grad_(False)
+        self.to(device)
+
+    def get_extra_state(self):
+        state = super().get_extra_state()
+        state.update(algorithm="MATD3", independent_critics=2)
+        return state
+
+    @property
+    def parameters_critic(self):
+        return {key: (list(self.critic_A_representation[key].parameters()) +
+                      list(self.critic_A[key].parameters()) +
+                      list(self.critic_B_representation[key].parameters()) +
+                      list(self.critic_B[key].parameters())) for key in self.model_keys}
+
+    def _twin_values(self, joint_observation, joint_actions, agent_ids, target, agent_key=None):
+        observations, actions = self._tensor(joint_observation), self._tensor(joint_actions)
+        if observations.ndim != 2 or observations.shape[-1] != self.n_agents * self.layout.obs_dim:
+            raise ValueError("UAV HGAT critic requires batched joint observations in agent order")
+        batch = observations.shape[0]
+        if actions.shape != (batch, 3 * self.n_agents):
+            raise ValueError("UAV HGAT critic requires all joint acceleration actions")
+        ids = self._tensor(agent_ids)
+        twin = []
+        for branch in ("A", "B"):
+            prefix = "target_critic_" if target else "critic_"
+            representations = getattr(self, prefix + branch + "_representation")
+            heads = getattr(self, prefix + branch)
+            values = {}
+            for key in ([agent_key] if agent_key else self.model_keys):
+                state = (representations[key](observations.reshape(batch * self.n_agents, self.layout.obs_dim))[
+                    "state"].reshape(batch, -1) if self.critic_hgat else observations)
+                joint = torch.cat((state, actions), dim=-1)
+                joint = joint.unsqueeze(1).expand(-1, self.n_agents, -1).reshape(batch * self.n_agents, -1)
+                values[key] = heads[key](torch.cat((joint, ids), dim=-1))
+            twin.append(values)
+        return twin
+
+    def Qpolicy(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        q_a, q_b = self._twin_values(joint_observation, joint_actions, agent_ids, False, agent_key)
+        return q_a, q_b, {key: (q_a[key] + q_b[key]) * .5 for key in q_a}
+
+    def Qtarget(self, joint_observation, joint_actions, agent_ids, agent_key=None, rnn_hidden=None):
+        q_a, q_b = self._twin_values(joint_observation, joint_actions, agent_ids, True, agent_key)
+        return {key: torch.minimum(q_a[key], q_b[key]) for key in q_a}
+
+    @torch.no_grad()
+    def soft_update(self, tau=0.005):
+        for name in ("actor_representation", "actor", "critic_A_representation", "critic_A",
+                     "critic_B_representation", "critic_B"):
+            source, target = getattr(self, name), getattr(self, "target_" + name)
+            for parameter, target_parameter in zip(source.parameters(), target.parameters()):
+                target_parameter.lerp_(parameter, tau)
