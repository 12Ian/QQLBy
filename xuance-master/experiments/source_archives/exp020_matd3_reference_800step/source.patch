@@ -0,0 +1,112 @@
+"""Fairness, evidence preservation and fail-fast behavior of the serial runner."""
+from argparse import Namespace
+from copy import deepcopy
+import importlib.util
+import json
+from pathlib import Path
+import shutil
+
+import pytest
+import yaml
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def module(path=None):
+    path = path or ROOT / "tools/run_matd3_hgat_comparison.py"
+    spec = importlib.util.spec_from_file_location("comparison_under_test", path)
+    result = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(result)
+    return result
+
+
+def common():
+    return yaml.safe_load((ROOT / "experiments/matd3_current_environment.yaml").read_text())
+
+
+def test_only_network_and_run_identity_differ():
+    tool = module()
+    configs = tool.build_configs(common())
+    a, b = configs.values()
+    assert {k for k in a if a[k] != b[k]} == {"policy", "env_id"}
+    for config in configs.values():
+        assert config["running_steps"] == 6000000 and config["parallels"] == 16 and config["seed"] == 1
+        assert not config["uav_collision_enabled"] and not config["baseline_evaluate_full_episode"]
+        assert config["terminate_on_building_collision"] and config["terminate_on_boundary_collision"]
+        assert config["baseline_init_checkpoint"] is None and config["baseline_init_actor"] is None
+        assert [s["target_max_speed"] for s in config["curriculum_schedule"]] == [3, 5, 8, 10, 12]
+
+
+def test_environment_drift_is_rejected():
+    tool = module()
+    configs = tool.build_configs(common())
+    configs["matd3_hgat"]["safety_margin"] += 1
+    with pytest.raises(ValueError, match="differences"):
+        tool.validate_pair(configs)
+    changed = common()
+    changed["curriculum_schedule"][2]["target_max_speed"] = 7
+    with pytest.raises(ValueError, match="speeds"):
+        tool.build_configs(changed)
+
+
+def test_smoke_is_explicitly_small_and_still_paired():
+    configs = module().build_configs(common(), smoke=True)
+    for config in configs.values():
+        assert config["running_steps"] == 128 and config["episode_length"] == 32
+        assert config["test_episode"] == 2 and config["actor_update_delay"] == 2
+
+
+def test_frozen_source_changes_fail_but_outputs_are_allowed(tmp_path):
+    tool = module()
+    path = tmp_path / "code/example.py"
+    path.parent.mkdir()
+    path.write_text("original")
+    tool.write_json(tmp_path / "source_manifest.json", {"code/example.py": tool.digest(path)})
+    protocol = {"source_manifest_sha256": tool.digest(tmp_path / "source_manifest.json")}
+    (tmp_path / "code/output.json").write_text("{}")
+    tool.verify_sources(tmp_path, protocol)
+    path.write_text("changed")
+    with pytest.raises(ValueError, match="Frozen source"):
+        tool.verify_sources(tmp_path, protocol)
+
+
+def test_first_training_failure_never_starts_hgat_and_rerun_is_refused(tmp_path, monkeypatch):
+    script = tmp_path / "code/tools/run_matd3_hgat_comparison.py"
+    script.parent.mkdir(parents=True)
+    shutil.copyfile(ROOT / "tools/run_matd3_hgat_comparison.py", script)
+    tool = module(script)
+    (tmp_path / "configs").mkdir()
+    for label, cfg in tool.build_configs(common(), smoke=True).items():
+        (tmp_path / "configs" / (label + ".yaml")).write_text(yaml.safe_dump(cfg))
+    tool.write_json(tmp_path / "source_manifest.json", {"code/tools/run_matd3_hgat_comparison.py": tool.digest(script)})
+    tool.write_json(tmp_path / "protocol.json", dict(source_manifest_sha256=tool.digest(tmp_path / "source_manifest.json"),
+                    device="cpu", min_free_gib=0, wait_for_processes=[]))
+    commands = []
+
+    class FailedProcess:
+        pid, returncode = 1234, 9
+
+        def __init__(self, command, **kwargs):
+            commands.append(command)
+
+        def poll(self):
+            return self.returncode
+
+    monkeypatch.setattr(tool.subprocess, "Popen", FailedProcess)
+    assert tool.execute(Namespace(run_dir=tmp_path)) == 1
+    assert len(commands) == 1 and "exp020_matd3" in commands[0]
+    state = json.loads((tmp_path / "process.json").read_text())
+    assert state["status"] == "failed" and state["phase"] == "matd3_train"
+    with pytest.raises(FileExistsError):
+        tool.execute(Namespace(run_dir=tmp_path))
+    assert len(commands) == 1
+
+
+def test_mismatched_holdout_cases_are_rejected(tmp_path):
+    tool = module()
+    for label, sha in (("matd3", "scene_A"), ("matd3_hgat", "scene_B")):
+        (tmp_path / label).mkdir()
+        tool.write_json(tmp_path / label / "level_0.json", {"episodes": [{"env_seed": 1, "initial_sha256": sha}]})
+    with pytest.raises(ValueError, match="same initial cases"):
+        tool.write_comparison(tmp_path, {})
